# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Owner Information
OWNER_ID=your_telegram_user_id
OWNER_USERNAME=your_username

# Authorized Groups (comma separated)
AUTHORIZED_GROUPS=-100123456789,-100987654321

# Admin/Sudo Users (comma separated)
ADMIN_USERS=123456789,987654321

# Database Configuration (Already set by Replit)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Optional - Log Channel
LOG_CHANNEL=-100123456789

# Optional - GoFile Configuration
GOFILE_TOKEN=your_gofile_token_here

# Bot Settings
MAX_CONCURRENT_TASKS=5
DOWNLOAD_DIR=downloads
UPLOAD_DIR=uploads
THUMBNAIL_DIR=thumbnails
